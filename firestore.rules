rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == "owner-test-uid";
    }

    match /digests/{date} {
      allow read, write: if isOwner();
    }

    match /config/settings {
      allow read, write: if isOwner();
    }
  }
}
