rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == "ETuFSQc87GXecZg8JEgLqpYhgkL2";
    }

    match /digests/{date} {
      allow read, write: if isOwner();
    }

    match /config/settings {
      allow read, write: if isOwner();
    }

    match /congress/{docId} {
      allow read, write: if isOwner();
    }
  }
}
